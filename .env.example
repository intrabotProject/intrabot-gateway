# Port du gateway (orchestrateur)
APP_PORT=8000

# URLs des microservices downstream
INGESTION_SERVICE_URL=http://localhost:8001
SEARCH_SERVICE_URL=http://localhost:8002

# Timeout HTTP vers les services (secondes)
HTTP_TIMEOUT=60

# Origines autorisées pour CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Clé API pour les routes /admin/* (scripts / dev — optionnel si JWT admin)
ADMIN_API_KEY=dev-admin-key

# Base utilisateurs (SQLite par défaut)
DATABASE_URL=sqlite:///./data/users.db

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Compte admin créé au premier démarrage s'il n'existe pas
BOOTSTRAP_ADMIN_EMAIL=admin@intrabot.local
BOOTSTRAP_ADMIN_PASSWORD=admin123456
