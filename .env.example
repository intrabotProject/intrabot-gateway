# Port du gateway (orchestrateur)
APP_PORT=8000

# URLs des microservices downstream
INGESTION_SERVICE_URL=http://localhost:8001
SEARCH_SERVICE_URL=http://localhost:8002

# Timeout HTTP vers les services (secondes)
HTTP_TIMEOUT=60

# Origines autorisées pour CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]
